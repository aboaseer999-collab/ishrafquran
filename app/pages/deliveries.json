{"html":"<!doctype html><html lang=\"ar\" dir=\"rtl\"><head><base target=\"_top\"><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>استلام الشهادات والمكافآت</title><style>\n:root{--navy:#173f4d;--teal:#2f849b;--gold:#c9aa62;--ink:#243842;--muted:#71818a;--bg:#f6f5f0;--line:#e6dfd1;--green:#23804b;--green-bg:#edf8f1;--red:#b94c47;--red-bg:#fff1f0;--gray:#78858b;--gray-bg:#f1f3f4}*{box-sizing:border-box}html,body{margin:0;min-height:100%}body{font-family:\"IBM Plex Sans Arabic\",\"Cairo\",Tahoma,sans-serif;background:radial-gradient(circle at 10% 0,rgba(47,132,155,.10),transparent 32%),var(--bg);color:var(--ink)}button,select,textarea,input{font:inherit}.topbar{background:#fff;border-bottom:1px solid var(--line);padding:16px max(20px,calc((100% - 1280px)/2));display:flex;align-items:center;justify-content:space-between;gap:16px}.title{font-size:26px;font-weight:800;color:var(--navy)}.back{border:1px solid var(--teal);background:#fff;color:var(--teal);font-weight:700;padding:11px 17px;border-radius:12px;cursor:pointer}.wrap{width:min(1280px,calc(100% - 28px));margin:24px auto 46px}.hero{background:linear-gradient(120deg,var(--navy),var(--teal));color:#fff;border-top:5px solid var(--gold);border-radius:22px;padding:27px 34px;box-shadow:0 16px 34px rgba(23,63,77,.14)}.hero h1{margin:0 0 8px;font-size:32px}.hero p{margin:0;color:#e6f2f5;font-size:16px;line-height:1.9}.panel{margin-top:20px;background:#fff;border:1px solid var(--line);border-radius:20px;padding:22px;box-shadow:0 12px 30px rgba(35,55,65,.08)}.filters{display:grid;grid-template-columns:repeat(6,minmax(135px,1fr));gap:12px}.field{display:grid;gap:7px}.field label{font-weight:700;color:var(--navy)}select{height:46px;border:1px solid #cbdde2;border-radius:11px;background:#fff;color:var(--ink);padding:0 12px;outline:none}.stats{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;margin-top:17px}.stat{display:flex;align-items:center;justify-content:space-between;gap:16px;border-radius:15px;padding:16px 18px;border:1px solid var(--line);background:#fbfcfc;border-right:5px solid var(--green)}.stat.gold{border-right-color:var(--gold)}.stat span{color:var(--muted);font-size:14px;font-weight:800}.stat strong{font-size:23px;color:var(--navy);white-space:nowrap}.message{display:none;margin:12px 0;padding:12px 14px;border-radius:11px;font-weight:700}.message.error{display:block;background:var(--red-bg);color:var(--red);border:1px solid #f1c9c6}.message.ok{display:block;background:var(--green-bg);color:var(--green);border:1px solid #cbe8d5}.bulkbar{margin-top:18px;padding:13px;border:1px solid #cfe3e9;border-radius:14px;background:#f5fafb;display:flex;align-items:center;gap:9px;flex-wrap:wrap}.bulkbar .selected{margin-left:auto;font-weight:800;color:var(--navy)}.bulk-btn{border:0;border-radius:9px;padding:10px 14px;color:#fff;font-weight:800;cursor:pointer}.bulk-btn:disabled{opacity:.45;cursor:not-allowed}.bulk-btn.cert{background:var(--teal)}.bulk-btn.notice{background:#a67c26}.bulk-btn.reward{background:var(--navy)}.select-all{display:inline-flex;align-items:center;gap:7px;font-weight:800;color:var(--navy);padding:0 5px}.select-all input,.row-check{width:19px;height:19px;accent-color:var(--teal)}.summary{display:flex;align-items:center;justify-content:space-between;gap:12px;margin:20px 0 12px}.summary h2{margin:0;color:var(--navy);font-size:23px}.count{background:#eef6f8;color:var(--teal);border:1px solid #cfe3e9;border-radius:999px;padding:8px 14px;font-weight:800}.loading,.empty{text-align:center;color:var(--muted);padding:35px;border:1px dashed #cfd8dc;border-radius:15px;background:#fbfcfc}.delivery-table-wrap{overflow-x:auto;border:1px solid var(--line);border-radius:15px}.delivery-table{width:100%;border-collapse:collapse;min-width:800px;background:#fff}.delivery-table th{padding:14px 13px;background:#eef6f8;color:var(--navy);font-size:14px;text-align:right;border-bottom:1px solid #cfe3e9}.delivery-table td{padding:13px;border-bottom:1px solid #eee9df;vertical-align:middle}.delivery-table tbody tr:last-child td{border-bottom:0}.delivery-table tr.selected-row{background:#f3fafc}.student-name{font-weight:800;color:var(--navy)}.level-name{color:var(--muted);font-weight:700}.delivery-done,.delivery-pending,.delivery-ineligible{display:inline-flex;align-items:center;justify-content:center;min-width:128px;padding:8px 11px;border-radius:999px;font-weight:800;font-size:13px}.delivery-done{color:var(--green);background:var(--green-bg);border:1px solid #c7e5d2}.delivery-pending{color:var(--red);background:var(--red-bg);border:1px solid #f1c9c6}.delivery-ineligible{color:var(--gray);background:var(--gray-bg);border:1px solid #dfe3e5}.modal-backdrop{position:fixed;inset:0;z-index:100;background:rgba(15,39,47,.62);display:flex;align-items:center;justify-content:center;padding:18px}.modal-backdrop.hidden{display:none}.modal{width:min(760px,100%);max-height:92vh;overflow:auto;background:#fff;border-radius:20px;border-top:5px solid var(--gold);box-shadow:0 24px 70px rgba(0,0,0,.28);padding:24px}.modal h2{margin:0;color:var(--navy)}.modal-lead{color:var(--muted);line-height:1.8}.review-list{margin:12px 0;padding:12px 18px;background:#f7f8f7;border:1px solid var(--line);border-radius:12px;max-height:180px;overflow:auto}.review-list li{margin:5px 0}.personal-preview{display:none;max-height:390px;overflow:auto;margin:12px 0}.personal-message{border:1px solid #cfe3e9;border-right:4px solid var(--teal);border-radius:13px;background:#f7fbfc;padding:13px 15px;margin-top:10px}.personal-message strong{display:block;color:var(--navy);margin-bottom:8px}.personal-message p{margin:0;line-height:1.85;white-space:pre-wrap;color:var(--ink)}.template-label{display:block;font-weight:800;color:var(--navy);margin:13px 0 7px}.template-help{font-size:12px;color:var(--muted);margin:6px 0}.template{width:100%;min-height:180px;resize:vertical;border:1px solid #cbdde2;border-radius:12px;padding:13px;line-height:1.9}.modal-actions{display:flex;justify-content:flex-start;gap:9px;flex-wrap:wrap;margin-top:17px}.modal-action{border:0;border-radius:10px;padding:11px 17px;font-weight:800;cursor:pointer}.modal-action.primary{background:var(--teal);color:#fff}.modal-action.confirm{background:var(--navy);color:#fff}.modal-action.cancel{background:#f0eee8;color:var(--ink)}@media(max-width:1050px){.filters{grid-template-columns:repeat(3,1fr)}}@media(max-width:700px){.filters,.stats{grid-template-columns:1fr}.topbar{align-items:flex-start}.title{font-size:20px}.panel{padding:14px}.hero{padding:22px 19px}.hero h1{font-size:25px}.bulkbar{align-items:stretch}.bulkbar .selected{width:100%;margin:0}.bulk-btn{flex:1}.modal{padding:18px}}\n</style><style data-system-typography=\"thmanyah\">@font-face{font-family:\"thmanyah sans Regular\";src:url(\"https://framerusercontent.com/assets/x6EBzvXf1Fi35XhsRoHxePDVo.woff2\") format(\"woff2\");font-display:swap;font-style:normal;font-weight:400}@font-face{font-family:\"thmanyah sans Bold\";src:url(\"https://framerusercontent.com/assets/LZvgFRUsP7pGWYj3tKxMUrKuhSY.woff2\") format(\"woff2\");font-display:swap;font-style:normal;font-weight:700}:root{--system-font-body:\"thmanyah sans Regular\",\"IBM Plex Sans Arabic\",\"Cairo\",Tahoma,Arial,sans-serif;--system-font-title:\"thmanyah sans Bold\",\"IBM Plex Sans Arabic\",\"Cairo\",Tahoma,Arial,sans-serif;--system-font-action:\"thmanyah sans Bold\",\"IBM Plex Sans Arabic\",\"Cairo\",Tahoma,Arial,sans-serif}html,body,input,textarea,select{font-family:var(--system-font-body)!important}p:not(#system-font-a#system-font-b),li:not(#system-font-a#system-font-b),td:not(#system-font-a#system-font-b),th:not(#system-font-a#system-font-b),small:not(#system-font-a#system-font-b),.subtitle:not(#system-font-a#system-font-b),.sub-title:not(#system-font-a#system-font-b),.description:not(#system-font-a#system-font-b),.desc:not(#system-font-a#system-font-b),.hint:not(#system-font-a#system-font-b),.help:not(#system-font-a#system-font-b),.muted:not(#system-font-a#system-font-b),.meta:not(#system-font-a#system-font-b),.note:not(#system-font-a#system-font-b),.message:not(#system-font-a#system-font-b){font-family:var(--system-font-body)!important}h1:not(#system-font-a#system-font-b),h2:not(#system-font-a#system-font-b),h3:not(#system-font-a#system-font-b),h4:not(#system-font-a#system-font-b),h5:not(#system-font-a#system-font-b),h6:not(#system-font-a#system-font-b),.title:not(#system-font-a#system-font-b),.hero-title:not(#system-font-a#system-font-b),.page-title:not(#system-font-a#system-font-b),.section-title:not(#system-font-a#system-font-b),.card-title:not(#system-font-a#system-font-b),.brand-title:not(#system-font-a#system-font-b),.mast-title:not(#system-font-a#system-font-b){font-family:var(--system-font-title)!important;font-weight:700!important}a:not(#system-font-a#system-font-b),button:not(#system-font-a#system-font-b),.btn:not(#system-font-a#system-font-b),[role=\"button\"]:not(#system-font-a#system-font-b),input[type=\"button\"]:not(#system-font-a#system-font-b),input[type=\"submit\"]:not(#system-font-a#system-font-b),input[type=\"reset\"]:not(#system-font-a#system-font-b),.nav-link:not(#system-font-a#system-font-b),.menu-item:not(#system-font-a#system-font-b),.tab:not(#system-font-a#system-font-b),.action:not(#system-font-a#system-font-b),.chip-action:not(#system-font-a#system-font-b){font-family:var(--system-font-action)!important;font-weight:700!important}h1:not(#system-font-a#system-font-b) span,h2:not(#system-font-a#system-font-b) span,h3:not(#system-font-a#system-font-b) span,.title:not(#system-font-a#system-font-b) span,.hero-title:not(#system-font-a#system-font-b) span,a:not(#system-font-a#system-font-b) span,a:not(#system-font-a#system-font-b) p,button:not(#system-font-a#system-font-b) span{font-family:inherit!important;font-weight:inherit!important}.hero-eyebrow:not(#system-font-a#system-font-b),.eyebrow:not(#system-font-a#system-font-b),.kicker:not(#system-font-a#system-font-b),.overline:not(#system-font-a#system-font-b),.hero-subtitle:not(#system-font-a#system-font-b),.page-subtitle:not(#system-font-a#system-font-b){font-family:var(--system-font-body)!important;font-weight:400!important}label:not(#system-font-a#system-font-b),legend:not(#system-font-a#system-font-b),.label:not(#system-font-a#system-font-b){font-family:var(--system-font-body)!important}.material-icons,.material-icons-outlined,.material-icons-round,.material-icons-sharp,.material-symbols-outlined,.material-symbols-rounded,.material-symbols-sharp,[class^=\"fa-\"],[class*=\" fa-\"],[class^=\"bi-\"],[class*=\" bi-\"]{font-family:inherit}.material-icons{font-family:\"Material Icons\"!important;font-weight:normal!important}.material-icons-outlined{font-family:\"Material Icons Outlined\"!important;font-weight:normal!important}.material-icons-round{font-family:\"Material Icons Round\"!important;font-weight:normal!important}.material-icons-sharp{font-family:\"Material Icons Sharp\"!important;font-weight:normal!important}.material-symbols-outlined,.material-symbols-rounded,.material-symbols-sharp{font-family:\"Material Symbols Outlined\"!important;font-weight:normal!important}@media print{html,body,.report-paper,.paper,.report-section,.section,.narrative,table,th,td{font-family:var(--system-font-body)!important}h1,h2,h3,h4,h5,h6,.report-head h1,.report-head h2,.report-section h3,.section h2{font-family:var(--system-font-title)!important;font-weight:700!important}@page{@bottom-center{font-family:\"thmanyah sans Regular\",Arial,sans-serif}}}</style></head><body><header class=\"topbar\"><div class=\"title\">استلام الشهادات والمكافآت</div><button class=\"back\" type=\"button\" onclick=\"backToPortal()\">العودة لصفحة المشرف</button></header><main class=\"wrap\"><section class=\"hero\"><h1>سجل الاستلام الموحّد</h1><p>إرسال الإشعارات لمجموعة من أولياء الأمور، ثم اعتماد استلام الشهادات والمكافآت بصورة مستقلة.</p></section><section class=\"panel\"><div class=\"filters\"><div class=\"field\"><label for=\"venue\">المركز الإشرافي</label><select id=\"venue\"><option value=\"\">جميع المراكز</option></select></div><div class=\"field\"><label for=\"group\">المجمع أو الحلقة</label><select id=\"group\"><option value=\"\">جميع الحلقات</option></select></div><div class=\"field\"><label for=\"level\">المرحلية</label><select id=\"level\"><option value=\"\">جميع المرحليات</option></select></div><div class=\"field\"><label for=\"completionStatus\">حالة السجل</label><select id=\"completionStatus\"><option value=\"incomplete\">غير المكتملين</option><option value=\"completed\">المكتملون</option><option value=\"all\">الجميع</option></select></div><div class=\"field\"><label for=\"certificateStatus\">حالة الشهادة</label><select id=\"certificateStatus\"><option value=\"\">الكل</option><option value=\"received\">تم التسليم</option><option value=\"pending\">بانتظار التسليم</option></select></div><div class=\"field\"><label for=\"rewardStatus\">حالة المكافأة</label><select id=\"rewardStatus\"><option value=\"\">الكل</option><option value=\"eligible\">مستحق</option><option value=\"received\">تم الاستلام</option><option value=\"pending\">بانتظار الاستلام</option><option value=\"not-eligible\">غير مستحق</option></select></div></div><div class=\"stats\"><div class=\"stat\"><span>تم تسليم الشهادات</span><strong id=\"certProgress\">0 من 0</strong></div><div class=\"stat\"><span>تم تسليم المكافآت</span><strong id=\"rewardProgress\">0 من 0</strong></div><div class=\"stat gold\"><span>السجلات المكتملة</span><strong id=\"completeProgress\">0 من 0</strong></div><div class=\"stat gold\"><span>100 ريال — درجات 90–100</span><strong id=\"rewardTier100\">0</strong></div><div class=\"stat\"><span>70 ريالًا — درجات 80–89</span><strong id=\"rewardTier70\">0</strong></div><div class=\"stat\"><span>50 ريالًا — درجات 70–79</span><strong id=\"rewardTier50\">0</strong></div></div><div id=\"message\" class=\"message\"></div><div class=\"bulkbar\"><label class=\"select-all\"><input id=\"selectAll\" type=\"checkbox\" onchange=\"toggleAll(this.checked)\"> تحديد الكل الظاهر</label><button id=\"certBulk\" class=\"bulk-btn cert\" type=\"button\" onclick=\"prepareBulk('certificate')\" disabled>إرسال رسائل الشهادات</button><button id=\"rewardNoticeBulk\" class=\"bulk-btn notice\" type=\"button\" onclick=\"prepareBulk('rewardNotice')\" disabled>إرسال موعد المكافآت</button><button id=\"rewardConfirmBulk\" class=\"bulk-btn reward\" type=\"button\" onclick=\"prepareBulk('rewardConfirm')\" disabled>تأكيد تسليم المكافآت</button><span id=\"selectedCount\" class=\"selected\">لم يتم تحديد طلاب</span></div><div class=\"summary\"><h2>قائمة الطلاب</h2><div class=\"count\" id=\"progress\">0 طالب</div></div><div id=\"list\"><div class=\"loading\">جارٍ تحميل بيانات الاستلام...</div></div></section></main>\n<div id=\"modalBackdrop\" class=\"modal-backdrop hidden\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"modalTitle\"><section class=\"modal\"><h2 id=\"modalTitle\"></h2><p id=\"modalLead\" class=\"modal-lead\"></p><ul id=\"reviewList\" class=\"review-list\"></ul><div id=\"personalPreview\" class=\"personal-preview\"></div><div id=\"templateBox\"><label class=\"template-label\" for=\"messageTemplate\">نص الرسالة</label><p class=\"template-help\">يمكن استخدام: {اسم الطالب}، {المرحلية}، {المجمع أو الحلقة}، {قيمة المكافأة}.</p><textarea id=\"messageTemplate\" class=\"template\"></textarea></div><div class=\"modal-actions\"><button id=\"modalPrimary\" class=\"modal-action primary\" type=\"button\"></button><button class=\"modal-action cancel\" type=\"button\" onclick=\"closeModal()\">إلغاء</button></div></section></div>\n<script>\nconst NAV_TICKET=\"\",WEB_APP_URL=\"https://script.google.com/macros/s/AKfycbzpDJKLle8sT7AyxX_EhFNbRkYm2aE4Ztd3dToGb_qaZZwX4YtNMEBc5xBAR5M7aq4r/exec\";let authToken='',lastData={students:[],options:{venues:[],groupsByVenue:{},levels:[]}},selectedIds=new Set(),pendingCertificateIds=[];const $=id=>document.getElementById(id);\nfunction esc(v){return String(v==null?'':v).replace(/[&<>\"']/g,ch=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[ch]));}function backToPortal(){window.top.location.href =WEB_APP_URL+'?page=admin';}function showMessage(t,type){const e=$('message');e.textContent=t||'';e.className='message '+(type||'');}function filters(){return{venue:$('venue').value,group:$('group').value,level:$('level').value,completionStatus:$('completionStatus').value,certificateStatus:$('certificateStatus').value,rewardStatus:$('rewardStatus').value};}function option(v,l){return '<option value=\"'+esc(v)+'\">'+esc(l||v)+'</option>';}function normalizePhone(p){p=String(p||'').replace(/\\D/g,'');if(p.startsWith('00'))p=p.slice(2);if(p.startsWith('0'))p='966'+p.slice(1);if(p&&!p.startsWith('966'))p='966'+p;return p;}function validPhone(s){return /^9665[0-9]{8}$/.test(normalizePhone(s.phone));}\nfunction populateGroups(map){const venue=$('venue').value,current=$('group').value;let groups=[];if(venue)groups=map[venue]||[];else Object.keys(map).forEach(k=>(map[k]||[]).forEach(g=>{if(!groups.includes(g))groups.push(g);}));groups.sort((a,b)=>a.localeCompare(b,'ar'));$('group').innerHTML=option('','جميع الحلقات')+groups.map(x=>option(x)).join('');if(groups.includes(current))$('group').value=current;}function populateOptions(o){const v=$('venue').value,l=$('level').value;$('venue').innerHTML=option('','جميع المراكز')+(o.venues||[]).map(x=>option(x)).join('');$('level').innerHTML=option('','جميع المرحليات')+(o.levels||[]).map(x=>option(x)).join('');if((o.venues||[]).includes(v))$('venue').value=v;if((o.levels||[]).includes(l))$('level').value=l;populateGroups(o.groupsByVenue||{});}\nfunction certificateTemplate(){return 'السلام عليكم ورحمة الله وبركاته\\n\\nنفيدكم بأنه تم تسليم شهادة الطالب: {اسم الطالب}، الخاصة بـ {المرحلية}، إلى المشرف المسؤول في {المجمع أو الحلقة}.\\nيرجى التواصل معه لاستلام الشهادة.\\n\\nمع خالص التقدير.';}function rewardTemplate(){return 'السلام عليكم ورحمة الله وبركاته\\n\\nنفيدكم بأن موعد تسليم مكافأة الطالب: {اسم الطالب}، المستحقة عن {المرحلية}، وقيمتها {قيمة المكافأة}، سيكون في الموعد والمكان الآتيين:\\n\\nاكتب هنا اليوم والتاريخ والوقت ومكان التسليم.\\n\\nنأمل الحضور في الموعد المحدد.\\n\\nمع خالص التقدير.';}function fillTemplate(t,s){return String(t||'').replace(/\\{اسم الطالب\\}/g,s.studentName||'الطالب').replace(/\\{المرحلية\\}/g,s.level||'المرحلية المحددة').replace(/\\{المجمع أو الحلقة\\}/g,s.group||'الجهة المسؤولة').replace(/\\{قيمة المكافأة\\}/g,(s.rewardAmount||0)+' ريالًا');}\nfunction statusBadge(s,type){if(type==='certificate')return s.certificateReceived?'<span class=\"delivery-done\">تم تسليم الشهادة</span>':'<span class=\"delivery-pending\">بانتظار تسليم الشهادة</span>';if(!s.rewardEligible)return '<span class=\"delivery-ineligible\">غير مستحق</span>';return s.rewardReceived?'<span class=\"delivery-done\">تم استلام المكافأة</span>':'<span class=\"delivery-pending\">بانتظار استلام المكافأة</span>';}\nfunction render(data){lastData=data||lastData;selectedIds.clear();const st=data.stats||{};$('certProgress').textContent=(st.certificatesReceived||0)+' من '+(st.total||0);$('rewardProgress').textContent=(st.rewardsReceived||0)+' من '+(st.rewardsEligible||0);$('completeProgress').textContent=(st.completed||0)+' من '+(st.total||0);$('rewardTier100').textContent=st.rewardTier100||0;$('rewardTier70').textContent=st.rewardTier70||0;$('rewardTier50').textContent=st.rewardTier50||0;const list=data.students||[];$('progress').textContent=list.length+' طالب';if(!list.length){$('list').innerHTML='<div class=\"empty\">لا توجد سجلات مطابقة. القائمة الافتراضية تعرض الطلاب غير المكتملين، ويمكن عرض المكتملين من الفلتر.</div>';updateSelection();return;}$('list').innerHTML='<div class=\"delivery-table-wrap\"><table class=\"delivery-table\"><thead><tr><th>تحديد</th><th>اسم الطالب</th><th>المرحلية</th><th>قيمة المكافأة</th><th>استلام الشهادة</th><th>استلام المكافأة</th></tr></thead><tbody>'+list.map(s=>'<tr id=\"row-'+esc(s.requestId)+'\"><td><input class=\"row-check\" type=\"checkbox\" value=\"'+esc(s.requestId)+'\" onchange=\"toggleOne(this.value,this.checked)\"></td><td class=\"student-name\">'+esc(s.studentName)+'</td><td class=\"level-name\">'+esc(s.level||'-')+'</td><td>'+(s.rewardEligible?esc(s.rewardAmount)+' ريالًا':'—')+'</td><td>'+statusBadge(s,'certificate')+'</td><td>'+statusBadge(s,'reward')+'</td></tr>').join('')+'</tbody></table></div>';updateSelection();}\nfunction selectedStudents(){return(lastData.students||[]).filter(s=>selectedIds.has(s.requestId));}function toggleOne(id,checked){if(checked)selectedIds.add(id);else selectedIds.delete(id);const row=document.getElementById('row-'+id);if(row)row.classList.toggle('selected-row',checked);updateSelection();}function toggleAll(checked){document.querySelectorAll('.row-check').forEach(cb=>{cb.checked=checked;toggleOne(cb.value,checked);});}function updateSelection(){const n=selectedIds.size;$('selectedCount').textContent=n?n+' طالب محدد':'لم يتم تحديد طلاب';$('certBulk').disabled=!n;$('rewardNoticeBulk').disabled=!n;$('rewardConfirmBulk').disabled=!n;const checks=[...document.querySelectorAll('.row-check')];$('selectAll').checked=checks.length>0&&checks.every(cb=>cb.checked);}\nfunction eligibleFor(type){const selected=selectedStudents();if(type==='certificate')return selected.filter(s=>!s.certificateReceived);if(type==='rewardNotice'||type==='rewardConfirm')return selected.filter(s=>s.rewardEligible&&!s.rewardReceived);return [];}function namesHtml(students){return students.map(s=>'<li><b>'+esc(s.studentName)+'</b> — '+esc(s.level||'-')+(s.rewardEligible?' — '+esc(s.rewardAmount)+' ريالًا':'')+(validPhone(s)?'':' — <span style=\"color:#b94c47\">رقم الجوال غير صالح</span>')+'</li>').join('');}\nfunction personalizedMessages(students){return students.map(s=>'<article class=\"personal-message\"><strong>'+esc(s.studentName)+' — '+esc(s.level||'-')+'</strong><p>'+esc(fillTemplate(certificateTemplate(),s))+'</p></article>').join('');}\nfunction prepareBulk(type){const students=eligibleFor(type);if(!students.length){showMessage(type==='certificate'?'لا يوجد بين المحددين طالب بانتظار تسليم الشهادة.':'لا يوجد بين المحددين طالب مستحق بانتظار المكافأة.','error');return;}$('modalBackdrop').classList.remove('hidden');$('reviewList').style.display='block';$('reviewList').innerHTML=namesHtml(students);$('personalPreview').style.display='none';$('personalPreview').innerHTML='';$('templateBox').style.display=type==='rewardConfirm'?'none':'block';const primary=$('modalPrimary');primary.className='modal-action '+(type==='rewardConfirm'?'confirm':'primary');if(type==='certificate'){$('modalTitle').textContent='مراجعة رسائل الشهادات';$('modalLead').textContent='هذه رسائل ثابتة وجاهزة؛ أُدخل اسم كل طالب ومرحلته ومجمعه تلقائيًا. بعد فتحها ستظهر خطوة تأكيد تسليم الشهادات.';$('reviewList').style.display='none';$('templateBox').style.display='none';$('personalPreview').style.display='block';$('personalPreview').innerHTML=personalizedMessages(students);primary.textContent='فتح رسائل واتساب';primary.onclick=()=>openMessages(students,'certificate',certificateTemplate());}else if(type==='rewardNotice'){$('modalTitle').textContent='صياغة موعد تسليم المكافآت';$('modalLead').textContent='عدّل الموعد والمكان في النص، ثم راجع الأسماء قبل فتح الرسائل. لن تتغير حالة استلام المكافأة.';$('messageTemplate').value=rewardTemplate();primary.textContent='فتح الرسائل وتأكيد الإشعار';primary.onclick=()=>openMessages(students,'reward');}else{$('modalTitle').textContent='تأكيد تسليم المكافآت';$('modalLead').textContent='ستتغير حالة الطلاب الآتين إلى تم استلام المكافأة. من اكتملت شهادته ومكافأته سيختفي من القائمة الافتراضية.';primary.textContent='تأكيد تسليم المحددين';primary.onclick=()=>confirmRewards(students.map(s=>s.requestId));}}\nfunction openMessages(students,type,fixedTemplate){const template=String(fixedTemplate||$('messageTemplate').value).trim();if(!template){showMessage('اكتب نص الرسالة أولًا.','error');return;}const opened=students.filter(validPhone).map(s=>s.requestId);students.forEach(s=>{if(validPhone(s))window.open('https://wa.me/'+normalizePhone(s.phone)+'?text='+encodeURIComponent(fillTemplate(template,s)),'_blank','noopener');});if(!opened.length){showMessage('لا يوجد بين المحددين رقم جوال صالح لإرسال واتساب.','error');closeModal();return;}if(type==='certificate'){pendingCertificateIds=opened;showCertificateConfirmation(opened);}else{google.script.run.withSuccessHandler(res=>{if(!res||res.ok===false){showMessage((res&&res.message)||'تعذر حفظ الإشعارات.','error');return;}showMessage(res.message||'تم تسجيل إرسال الإشعارات دون تغيير حالة المكافأة.','ok');closeModal();loadData(true);}).withFailureHandler(e=>showMessage((e&&e.message)||String(e),'error')).recordRewardNotificationsBulk(authToken,opened);}}\nfunction showCertificateConfirmation(ids){const students=(lastData.students||[]).filter(s=>ids.includes(s.requestId));$('modalTitle').textContent='تأكيد تسليم الشهادات';$('modalLead').textContent='بعد التأكد من تجهيز الرسائل، اضغط التأكيد لتتحول حالة الشهادات وتختفي السجلات المكتملة من القائمة الافتراضية.';$('reviewList').style.display='block';$('reviewList').innerHTML=namesHtml(students);$('personalPreview').style.display='none';$('templateBox').style.display='none';const primary=$('modalPrimary');primary.className='modal-action confirm';primary.textContent='تأكيد تسليم الشهادات';primary.onclick=confirmCertificates;}\nfunction confirmCertificates(){if(!pendingCertificateIds.length)return;const ids=pendingCertificateIds.slice();$('modalPrimary').disabled=true;google.script.run.withSuccessHandler(res=>{if(!res||res.ok===false){showMessage((res&&res.message)||'تعذر تأكيد الشهادات.','error');$('modalPrimary').disabled=false;return;}pendingCertificateIds=[];showMessage(res.message||'تم تأكيد تسليم الشهادات.','ok');closeModal();loadData(true);}).withFailureHandler(e=>{showMessage((e&&e.message)||String(e),'error');$('modalPrimary').disabled=false;}).confirmCertificatesBulk(authToken,ids);}function confirmRewards(ids){$('modalPrimary').disabled=true;google.script.run.withSuccessHandler(res=>{if(!res||res.ok===false){showMessage((res&&res.message)||'تعذر تأكيد المكافآت.','error');$('modalPrimary').disabled=false;return;}showMessage(res.message||'تم تأكيد استلام المكافآت.','ok');closeModal();loadData(true);}).withFailureHandler(e=>{showMessage((e&&e.message)||String(e),'error');$('modalPrimary').disabled=false;}).confirmRewardsBulk(authToken,ids);}function closeModal(){$('modalBackdrop').classList.add('hidden');$('modalPrimary').disabled=false;}\nfunction loadData(keep){$('list').innerHTML='<div class=\"loading\">جارٍ تحميل بيانات الاستلام...</div>';showMessage('','');google.script.run.withSuccessHandler(data=>{if(!data||data.ok===false){showMessage((data&&data.message)||'تعذر تحميل البيانات.','error');return;}if(!keep)populateOptions(data.options||{});render(data);}).withFailureHandler(e=>{showMessage((e&&e.message)||String(e)||'تعذر تحميل البيانات.','error');$('list').innerHTML='<div class=\"empty\">تعذر تحميل القائمة، أعد المحاولة.</div>';}).getCombinedDeliveryData(authToken,filters());}function verifySession(){showMessage('جارٍ التحقق من صلاحية الدخول...','');google.script.run.withSuccessHandler(res=>{if(!res||!res.ok||!res.authenticated){showMessage((res&&res.message)||'انتهت جلسة المشرف. افتح الصفحة من بوابة المشرف.','error');return;}authToken=res.token;showMessage('','');loadData(false);}).withFailureHandler(e=>showMessage((e&&e.message)||String(e)||'تعذر التحقق من الجلسة.','error')).authPortalConsumeNavigationTicket(NAV_TICKET,'deliveries');}['group','level','completionStatus','certificateStatus','rewardStatus'].forEach(id=>$(id).addEventListener('change',()=>loadData(true)));$('venue').addEventListener('change',()=>{populateGroups((lastData.options||{}).groupsByVenue||{});loadData(true);});$('modalBackdrop').addEventListener('click',e=>{if(e.target===$('modalBackdrop'))closeModal();});verifySession();\n</script><script data-system-arabic-digits=\"enabled\">(function(){var digits=\"٠١٢٣٤٥٦٧٨٩\";function arabicNumberText(value){return String(value==null?\"\":value).replace(/[0-9]/g,function(d){return digits.charAt(Number(d));});}function excluded(node){var parent=node&&node.parentElement;return !parent||/^(SCRIPT|STYLE|NOSCRIPT|CODE|PRE)$/i.test(parent.tagName);}function convertText(node){if(!node||excluded(node))return;var next=arabicNumberText(node.nodeValue);if(next!==node.nodeValue)node.nodeValue=next;}function convertAttributes(root){if(!root||root.nodeType!==1)return;var elements=[root].concat(Array.prototype.slice.call(root.querySelectorAll(\"[title],[aria-label],[placeholder]\")));elements.forEach(function(el){[\"title\",\"aria-label\",\"placeholder\"].forEach(function(name){if(!el.hasAttribute(name))return;var oldValue=el.getAttribute(name),newValue=arabicNumberText(oldValue);if(newValue!==oldValue)el.setAttribute(name,newValue);});});}function convertTree(root){if(!root)return;if(root.nodeType===3){convertText(root);return;}if(root.nodeType!==1&&root.nodeType!==9&&root.nodeType!==11)return;convertAttributes(root.nodeType===1?root:null);var walker=document.createTreeWalker(root,NodeFilter.SHOW_TEXT);var node;while((node=walker.nextNode()))convertText(node);}function start(){convertTree(document.body);new MutationObserver(function(records){records.forEach(function(record){if(record.type===\"characterData\")convertText(record.target);Array.prototype.forEach.call(record.addedNodes||[],convertTree);});}).observe(document.body,{subtree:true,childList:true,characterData:true});}if(document.readyState===\"loading\")document.addEventListener(\"DOMContentLoaded\",start,{once:true});else start();})();</script></body></html>","title":"استلام الشهادات والمكافآت"}