{"html":"<!doctype html>\n<html lang=\"ar\" dir=\"rtl\">\n<head><base target=\"_top\">\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n  <title>استلام الشهادات</title>\n  <style>\n    :root{--navy:#173f4d;--teal:#2f849b;--gold:#c9aa62;--ink:#243842;--muted:#71818a;--paper:#fff;--bg:#f6f5f0;--line:#e6dfd1;--green:#23804b;--green-bg:#edf8f1;--red:#b94c47;--red-bg:#fff1f0}\n    *{box-sizing:border-box}html,body{margin:0;min-height:100%}body{font-family:Arial,\"Tahoma\",sans-serif;background:radial-gradient(circle at 10% 0,rgba(47,132,155,.10),transparent 32%),var(--bg);color:var(--ink)}\n    button,select{font:inherit}.topbar{background:#fff;border-bottom:1px solid var(--line);padding:16px max(20px,calc((100% - 1180px)/2));display:flex;align-items:center;justify-content:space-between;gap:16px}.title{font-size:26px;font-weight:800;color:var(--navy)}.back{border:1px solid var(--teal);background:#fff;color:var(--teal);font-weight:700;padding:11px 17px;border-radius:12px;cursor:pointer}\n    .wrap{width:min(1180px,calc(100% - 28px));margin:24px auto 46px}.hero{background:linear-gradient(120deg,var(--navy),var(--teal));color:#fff;border-top:5px solid var(--gold);border-radius:22px;padding:28px 34px;box-shadow:0 16px 34px rgba(23,63,77,.14)}.hero h1{margin:0 0 8px;font-size:34px}.hero p{margin:0;color:#e6f2f5;font-size:17px;line-height:1.9}\n    .panel{margin-top:20px;background:#fff;border:1px solid var(--line);border-radius:20px;padding:22px;box-shadow:0 12px 30px rgba(35,55,65,.08)}.filters{display:grid;grid-template-columns:repeat(4,minmax(150px,1fr));gap:13px}.field{display:grid;gap:7px}.field label{font-weight:700;color:var(--navy)}select{height:46px;border:1px solid #cbdde2;border-radius:11px;background:#fff;color:var(--ink);padding:0 12px;outline:none}select:focus{border-color:var(--teal);box-shadow:0 0 0 3px rgba(47,132,155,.12)}\n    .stats{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:16px}.stat{border-radius:16px;padding:17px 19px;border:1px solid var(--line);background:#fbfcfc;position:relative;overflow:hidden}.stat:before{content:\"\";position:absolute;top:0;right:0;left:0;height:4px;background:var(--teal)}.stat.received:before{background:var(--green)}.stat.pending:before{background:var(--red)}.stat span{display:block;color:var(--muted);font-weight:700;margin-bottom:6px}.stat strong{font-size:30px;color:var(--navy)}.stat.received strong{color:var(--green)}.stat.pending strong{color:var(--red)}\n    .summary{display:flex;align-items:center;justify-content:space-between;gap:12px;margin:22px 0 12px}.summary h2{margin:0;color:var(--navy);font-size:23px}.count{background:#eef6f8;color:var(--teal);border:1px solid #cfe3e9;border-radius:999px;padding:8px 14px;font-weight:800}\n    .message{display:none;margin:12px 0;padding:12px 14px;border-radius:11px;font-weight:700}.message.error{display:block;background:var(--red-bg);color:var(--red);border:1px solid #f1c9c6}.message.ok{display:block;background:var(--green-bg);color:var(--green);border:1px solid #cbe8d5}.loading,.empty{text-align:center;color:var(--muted);padding:35px;border:1px dashed #cfd8dc;border-radius:15px;background:#fbfcfc}\n    .list{display:grid;gap:12px}.student{border:1px solid #efc5c2;border-right:6px solid var(--red);background:linear-gradient(90deg,#fff,var(--red-bg));border-radius:16px;padding:17px;display:grid;grid-template-columns:minmax(240px,1.4fr) minmax(270px,1fr) auto;align-items:center;gap:18px;transition:.2s}.student.done{border-color:#c7e5d2;border-right-color:var(--green);background:linear-gradient(90deg,#fff,var(--green-bg))}.student h3{margin:0 0 7px;color:var(--navy);font-size:19px}.meta{display:flex;gap:8px;flex-wrap:wrap;color:var(--muted);font-size:14px}.chip{padding:5px 9px;background:#fff;border:1px solid var(--line);border-radius:999px}.place{line-height:1.9}.place b{color:var(--navy)}.status{font-weight:800;margin-top:6px;color:var(--red)}.done .status{color:var(--green)}.actions{display:flex;gap:8px;flex-wrap:wrap;justify-content:flex-end}.btn{border:0;border-radius:11px;padding:11px 14px;font-weight:800;cursor:pointer;text-decoration:none;display:inline-flex;align-items:center;justify-content:center;min-width:125px}.whatsapp{background:#25d366;color:#fff}.confirm{background:var(--navy);color:#fff}.confirm[disabled]{opacity:.55;cursor:not-allowed}.done .confirm{display:none}.done .whatsapp{background:#6f8b78}\n    @media(max-width:850px){.filters{grid-template-columns:1fr 1fr}.student{grid-template-columns:1fr}.actions{justify-content:stretch}.btn{flex:1}.stats{grid-template-columns:1fr}.hero h1{font-size:28px}}\n    @media(max-width:520px){.filters{grid-template-columns:1fr}.topbar{align-items:flex-start}.title{font-size:21px}.panel{padding:15px}.hero{padding:23px 20px}}\n  </style>\n<style data-system-typography=\"thmanyah\">@font-face{font-family:\"thmanyah sans Regular\";src:url(\"https://framerusercontent.com/assets/x6EBzvXf1Fi35XhsRoHxePDVo.woff2\") format(\"woff2\");font-display:swap;font-style:normal;font-weight:400}@font-face{font-family:\"thmanyah sans Bold\";src:url(\"https://framerusercontent.com/assets/LZvgFRUsP7pGWYj3tKxMUrKuhSY.woff2\") format(\"woff2\");font-display:swap;font-style:normal;font-weight:700}:root{--system-font-body:\"thmanyah sans Regular\",\"IBM Plex Sans Arabic\",\"Cairo\",Tahoma,Arial,sans-serif;--system-font-title:\"thmanyah sans Bold\",\"IBM Plex Sans Arabic\",\"Cairo\",Tahoma,Arial,sans-serif;--system-font-action:\"thmanyah sans Bold\",\"IBM Plex Sans Arabic\",\"Cairo\",Tahoma,Arial,sans-serif}html,body,input,textarea,select{font-family:var(--system-font-body)!important}p:not(#system-font-a#system-font-b),li:not(#system-font-a#system-font-b),td:not(#system-font-a#system-font-b),th:not(#system-font-a#system-font-b),small:not(#system-font-a#system-font-b),.subtitle:not(#system-font-a#system-font-b),.sub-title:not(#system-font-a#system-font-b),.description:not(#system-font-a#system-font-b),.desc:not(#system-font-a#system-font-b),.hint:not(#system-font-a#system-font-b),.help:not(#system-font-a#system-font-b),.muted:not(#system-font-a#system-font-b),.meta:not(#system-font-a#system-font-b),.note:not(#system-font-a#system-font-b),.message:not(#system-font-a#system-font-b){font-family:var(--system-font-body)!important}h1:not(#system-font-a#system-font-b),h2:not(#system-font-a#system-font-b),h3:not(#system-font-a#system-font-b),h4:not(#system-font-a#system-font-b),h5:not(#system-font-a#system-font-b),h6:not(#system-font-a#system-font-b),.title:not(#system-font-a#system-font-b),.hero-title:not(#system-font-a#system-font-b),.page-title:not(#system-font-a#system-font-b),.section-title:not(#system-font-a#system-font-b),.card-title:not(#system-font-a#system-font-b),.brand-title:not(#system-font-a#system-font-b),.mast-title:not(#system-font-a#system-font-b){font-family:var(--system-font-title)!important;font-weight:700!important}a:not(#system-font-a#system-font-b),button:not(#system-font-a#system-font-b),.btn:not(#system-font-a#system-font-b),[role=\"button\"]:not(#system-font-a#system-font-b),input[type=\"button\"]:not(#system-font-a#system-font-b),input[type=\"submit\"]:not(#system-font-a#system-font-b),input[type=\"reset\"]:not(#system-font-a#system-font-b),.nav-link:not(#system-font-a#system-font-b),.menu-item:not(#system-font-a#system-font-b),.tab:not(#system-font-a#system-font-b),.action:not(#system-font-a#system-font-b),.chip-action:not(#system-font-a#system-font-b){font-family:var(--system-font-action)!important;font-weight:700!important}h1:not(#system-font-a#system-font-b) span,h2:not(#system-font-a#system-font-b) span,h3:not(#system-font-a#system-font-b) span,.title:not(#system-font-a#system-font-b) span,.hero-title:not(#system-font-a#system-font-b) span,a:not(#system-font-a#system-font-b) span,a:not(#system-font-a#system-font-b) p,button:not(#system-font-a#system-font-b) span{font-family:inherit!important;font-weight:inherit!important}.hero-eyebrow:not(#system-font-a#system-font-b),.eyebrow:not(#system-font-a#system-font-b),.kicker:not(#system-font-a#system-font-b),.overline:not(#system-font-a#system-font-b),.hero-subtitle:not(#system-font-a#system-font-b),.page-subtitle:not(#system-font-a#system-font-b){font-family:var(--system-font-body)!important;font-weight:400!important}label:not(#system-font-a#system-font-b),legend:not(#system-font-a#system-font-b),.label:not(#system-font-a#system-font-b){font-family:var(--system-font-body)!important}.material-icons,.material-icons-outlined,.material-icons-round,.material-icons-sharp,.material-symbols-outlined,.material-symbols-rounded,.material-symbols-sharp,[class^=\"fa-\"],[class*=\" fa-\"],[class^=\"bi-\"],[class*=\" bi-\"]{font-family:inherit}.material-icons{font-family:\"Material Icons\"!important;font-weight:normal!important}.material-icons-outlined{font-family:\"Material Icons Outlined\"!important;font-weight:normal!important}.material-icons-round{font-family:\"Material Icons Round\"!important;font-weight:normal!important}.material-icons-sharp{font-family:\"Material Icons Sharp\"!important;font-weight:normal!important}.material-symbols-outlined,.material-symbols-rounded,.material-symbols-sharp{font-family:\"Material Symbols Outlined\"!important;font-weight:normal!important}@media print{html,body,.report-paper,.paper,.report-section,.section,.narrative,table,th,td{font-family:var(--system-font-body)!important}h1,h2,h3,h4,h5,h6,.report-head h1,.report-head h2,.report-section h3,.section h2{font-family:var(--system-font-title)!important;font-weight:700!important}@page{@bottom-center{font-family:\"thmanyah sans Regular\",Arial,sans-serif}}}</style></head>\n<body>\n  <header class=\"topbar\"><div class=\"title\">استلام الشهادات</div><button class=\"back\" type=\"button\" onclick=\"backToPortal()\">العودة لصفحة المشرف</button></header>\n  <main class=\"wrap\">\n    <section class=\"hero\"><h1>سجل استلام الشهادات</h1><p>متابعة شهادات الطلاب المختبرين، وإشعار أولياء الأمور عبر واتساب، ومعرفة ما تم تسليمه وما بقي.</p></section>\n    <section class=\"panel\">\n      <div class=\"filters\">\n        <div class=\"field\"><label for=\"venue\">المركز الإشرافي</label><select id=\"venue\"><option value=\"\">جميع المراكز</option></select></div>\n        <div class=\"field\"><label for=\"group\">المجمع أو الحلقة</label><select id=\"group\"><option value=\"\">جميع الحلقات</option></select></div>\n        <div class=\"field\"><label for=\"level\">المرحلية</label><select id=\"level\"><option value=\"\">جميع المرحليات</option></select></div>\n        <div class=\"field\"><label for=\"status\">حالة الاستلام</label><select id=\"status\"><option value=\"\">الكل</option><option value=\"received\">تم الاستلام</option><option value=\"pending\">بانتظار الاستلام</option></select></div>\n      </div>\n      <div class=\"stats\">\n        <div class=\"stat\"><span>إجمالي المختبرين</span><strong id=\"total\">0</strong></div>\n        <div class=\"stat received\"><span>تم تسليم شهاداتهم</span><strong id=\"received\">0</strong></div>\n        <div class=\"stat pending\"><span>بانتظار الاستلام</span><strong id=\"pending\">0</strong></div>\n      </div>\n      <div id=\"message\" class=\"message\"></div>\n      <div class=\"summary\"><h2>قائمة الطلاب</h2><div class=\"count\" id=\"progress\">تم تسليم 0 من 0</div></div>\n      <div id=\"list\" class=\"list\"><div class=\"loading\">جارٍ تحميل بيانات الشهادات...</div></div>\n    </section>\n  </main>\n  <script>\n    const NAV_TICKET = \"\";\n    const WEB_APP_URL = \"https://script.google.com/macros/s/AKfycbzpDJKLle8sT7AyxX_EhFNbRkYm2aE4Ztd3dToGb_qaZZwX4YtNMEBc5xBAR5M7aq4r/exec\";\n    let authToken = '';\n    let lastData = {students:[],options:{venues:[],groupsByVenue:{},levels:[]}};\n    let openedWhatsApp = {};\n    const $ = id => document.getElementById(id);\n    function esc(value){return String(value==null?'':value).replace(/[&<>\"']/g,ch=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[ch]));}\n    function backToPortal(){window.top.location.href =WEB_APP_URL+'?page=admin&ticket='+encodeURIComponent(NAV_TICKET);}\n    function showMessage(text,type){const el=$('message');el.textContent=text||'';el.className='message '+(type||'');}\n    function verifySession(){showMessage('جارٍ التحقق من صلاحية الدخول...','');google.script.run.withSuccessHandler(res=>{if(!res||!res.ok||!res.authenticated){showMessage((res&&res.message)||'انتهت جلسة المشرف. افتح الصفحة من بوابة المشرف.','error');$('list').innerHTML='<div class=\"empty\">انتهت الجلسة. افتح الصفحة من بوابة المشرف.</div>';return;}authToken=res.token;showMessage('','');loadData(false);}).withFailureHandler(err=>{showMessage((err&&err.message)||String(err)||'تعذر التحقق من الجلسة.','error');$('list').innerHTML='<div class=\"empty\">تعذر التحقق من صلاحية الدخول.</div>';}).authPortalConsumeNavigationTicket(NAV_TICKET,'certificates');}\n    function filters(){return{venue:$('venue').value,group:$('group').value,level:$('level').value,status:$('status').value};}\n    function option(value,label){return '<option value=\"'+esc(value)+'\">'+esc(label||value)+'</option>';}\n    function populateOptions(opts){\n      const currentVenue=$('venue').value,currentLevel=$('level').value;\n      $('venue').innerHTML=option('','جميع المراكز')+(opts.venues||[]).map(x=>option(x)).join('');\n      $('level').innerHTML=option('','جميع المرحليات')+(opts.levels||[]).map(x=>option(x)).join('');\n      if((opts.venues||[]).includes(currentVenue))$('venue').value=currentVenue;\n      if((opts.levels||[]).includes(currentLevel))$('level').value=currentLevel;\n      populateGroups(opts.groupsByVenue||{});\n    }\n    function populateGroups(groupsByVenue){\n      const venue=$('venue').value,current=$('group').value;let groups=[];\n      if(venue)groups=groupsByVenue[venue]||[];else Object.keys(groupsByVenue).forEach(k=>(groupsByVenue[k]||[]).forEach(g=>{if(!groups.includes(g))groups.push(g);}));\n      groups.sort((a,b)=>a.localeCompare(b,'ar'));$('group').innerHTML=option('','جميع الحلقات')+groups.map(x=>option(x)).join('');if(groups.includes(current))$('group').value=current;\n    }\n    function normalizePhone(phone){let p=String(phone||'').replace(/\\D/g,'');if(p.startsWith('00'))p=p.slice(2);if(p.startsWith('0'))p='966'+p.slice(1);if(p&&!p.startsWith('966'))p='966'+p;return p;}\n    function whatsMessage(s){return 'السلام عليكم ورحمة الله وبركاته\\n\\nنفيدكم بأنه تم تسليم شهادة ابنكم: '+s.studentName+'، في '+s.level+'، إلى مشرف المجمع.\\nيرجى التواصل مع حلقة '+(s.group||'الطالب')+' لاستلام الشهادة.\\n\\nمع خالص التقدير.';}\n    function waUrl(s){return 'https://wa.me/'+normalizePhone(s.phone)+'?text='+encodeURIComponent(whatsMessage(s));}\n    function openWhatsApp(id){const s=lastData.students.find(x=>x.requestId===id);if(!s)return;openedWhatsApp[id]=true;window.open(waUrl(s),'_blank','noopener');const b=document.querySelector('[data-confirm=\"'+CSS.escape(id)+'\"]');if(b){b.disabled=false;b.textContent='تأكيد الإرسال والاستلام';}}\n    function render(data){\n      lastData=data||lastData;const st=data.stats||{total:0,received:0,pending:0};$('total').textContent=st.total||0;$('received').textContent=st.received||0;$('pending').textContent=st.pending||0;$('progress').textContent='تم تسليم '+(st.received||0)+' من '+(st.total||0);\n      const list=data.students||[];if(!list.length){$('list').innerHTML='<div class=\"empty\">لا توجد سجلات مطابقة لخيارات الفرز الحالية.</div>';return;}\n      $('list').innerHTML=list.map(s=>{const done=!!(s.received&&s.notified),id=esc(s.requestId);return '<article class=\"student '+(done?'done':'')+'\"><div><h3>'+esc(s.studentName)+'</h3><div class=\"meta\"><span class=\"chip\">'+esc(s.level||'المرحلية غير محددة')+'</span><span class=\"chip\">الدرجة: '+esc(s.degree||'-')+'</span><span class=\"chip\">'+esc(s.grade||'')+'</span></div></div><div class=\"place\"><div><b>المركز:</b> '+esc(s.venue||'-')+'</div><div><b>الحلقة:</b> '+esc(s.group||'-')+'</div><div class=\"status\">'+(done?'تم تسليم الشهادة وإشعار ولي الأمر':'بانتظار استلام الشهادة وإشعار ولي الأمر')+'</div></div><div class=\"actions\"><button class=\"btn whatsapp\" type=\"button\" onclick=\"openWhatsApp(\\''+id+'\\')\">واتساب ولي الأمر</button><button class=\"btn confirm\" data-confirm=\"'+id+'\" type=\"button\" '+(done?'':'disabled')+' onclick=\"confirmDone(\\''+id+'\\')\">'+(done?'تم التأكيد':'تأكيد الإرسال والاستلام')+'</button></div></article>';}).join('');\n    }\n    function loadData(keepOptions){$('list').innerHTML='<div class=\"loading\">جارٍ تحميل بيانات الشهادات...</div>';showMessage('','');google.script.run.withSuccessHandler(data=>{if(!data||data.ok===false){showMessage((data&&data.message)||'تعذر تحميل البيانات.','error');return;}if(!keepOptions)populateOptions(data.options||{});render(data);}).withFailureHandler(err=>{showMessage((err&&err.message)||String(err)||'تعذر تحميل البيانات.','error');$('list').innerHTML='<div class=\"empty\">تعذر تحميل القائمة، أعد المحاولة.</div>';}).getCertificateDeliveryData(authToken,filters());}\n    function confirmDone(id){if(!openedWhatsApp[id]&&!confirm('هل تم إرسال رسالة واتساب لولي الأمر؟'))return;const btn=document.querySelector('[data-confirm=\"'+CSS.escape(id)+'\"]');if(btn){btn.disabled=true;btn.textContent='جارٍ الحفظ...';}google.script.run.withSuccessHandler(res=>{if(!res||res.ok===false){showMessage((res&&res.message)||'تعذر حفظ التأكيد.','error');if(btn)btn.disabled=false;return;}showMessage(res.message||'تم تسجيل الاستلام والإشعار.','ok');loadData(true);}).withFailureHandler(err=>{showMessage((err&&err.message)||String(err)||'تعذر حفظ التأكيد.','error');if(btn)btn.disabled=false;}).confirmCertificateWhatsApp(authToken,id);}\n    $('venue').addEventListener('change',()=>{populateGroups((lastData.options||{}).groupsByVenue||{});loadData(true);});$('group').addEventListener('change',()=>loadData(true));$('level').addEventListener('change',()=>loadData(true));$('status').addEventListener('change',()=>loadData(true));verifySession();\n  </script>\n<script data-system-arabic-digits=\"enabled\">(function(){var digits=\"٠١٢٣٤٥٦٧٨٩\";function arabicNumberText(value){return String(value==null?\"\":value).replace(/[0-9]/g,function(d){return digits.charAt(Number(d));});}function excluded(node){var parent=node&&node.parentElement;return !parent||/^(SCRIPT|STYLE|NOSCRIPT|CODE|PRE)$/i.test(parent.tagName);}function convertText(node){if(!node||excluded(node))return;var next=arabicNumberText(node.nodeValue);if(next!==node.nodeValue)node.nodeValue=next;}function convertAttributes(root){if(!root||root.nodeType!==1)return;var elements=[root].concat(Array.prototype.slice.call(root.querySelectorAll(\"[title],[aria-label],[placeholder]\")));elements.forEach(function(el){[\"title\",\"aria-label\",\"placeholder\"].forEach(function(name){if(!el.hasAttribute(name))return;var oldValue=el.getAttribute(name),newValue=arabicNumberText(oldValue);if(newValue!==oldValue)el.setAttribute(name,newValue);});});}function convertTree(root){if(!root)return;if(root.nodeType===3){convertText(root);return;}if(root.nodeType!==1&&root.nodeType!==9&&root.nodeType!==11)return;convertAttributes(root.nodeType===1?root:null);var walker=document.createTreeWalker(root,NodeFilter.SHOW_TEXT);var node;while((node=walker.nextNode()))convertText(node);}function start(){convertTree(document.body);new MutationObserver(function(records){records.forEach(function(record){if(record.type===\"characterData\")convertText(record.target);Array.prototype.forEach.call(record.addedNodes||[],convertTree);});}).observe(document.body,{subtree:true,childList:true,characterData:true});}if(document.readyState===\"loading\")document.addEventListener(\"DOMContentLoaded\",start,{once:true});else start();})();</script></body>\n</html>\n\r\n","title":"استلام الشهادات — نظام الاختبارات"}